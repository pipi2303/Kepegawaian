# ===== KONFIGURASI APLIKASI =====
APP_NAME="HCMS RSUDAM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# ===== KONFIGURASI RUMAH SAKIT =====
NAMA_RS="Nama Rumah Sakit"
KOTA_RS="Kota"
KELAS_RS="B"
AKREDITASI_RS="KARS"
LOGO_RS=

# ===== LICENSE =====
LICENSE_KEY=
LICENSE_EXPIRE=

# ===== ERROR TRACKING =====
SENTRY_DSN=
APP_VERSION=1.0.0

# ===== DATABASE =====
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hcms_db
DB_USERNAME=hcms_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ===== SESSION & CACHE =====
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_IDLE_TIMEOUT=30
CACHE_STORE=redis

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ===== QUEUE =====
QUEUE_CONNECTION=redis

# ===== MAIL =====
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@rumahsakit.id
MAIL_FROM_NAME="${NAMA_RS}"

# ===== AI ASSISTANT =====
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# ===== STORAGE =====
FILESYSTEM_DISK=local

# ===== INTEGRASI PEMERINTAH =====
# SATUSEHAT (Kemenkes) — daftar di https://satusehat.kemkes.go.id
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=

# SIASN/BKN — daftar di https://siasn.bkn.go.id
SIASN_CLIENT_ID=
SIASN_CLIENT_SECRET=

# ===== BROADCASTING (Real-time) =====
BROADCAST_CONNECTION=pusher
PUSHER_APP_KEY=hcms-key
PUSHER_APP_SECRET=hcms-secret-change-me
PUSHER_APP_ID=1
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_PUSHER_APP_KEY=hcms-key
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
